# Copy to backend/.env and fill in. backend/.env is git-ignored.

# A Google AI Studio key selects hosted open-weight Gemma automatically.
# Existing LLM_BASE_URL / LLM_MODEL values can remain for the optional old provider.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it
LLM_PROVIDER=auto
GOOGLE_PROMPT_BUDGET_TOKENS=7000
GOOGLE_MAX_OUTPUT_TOKENS=3500
GOOGLE_TOKENS_PER_MINUTE=14000

# Organizer-hosted model server (OpenAI-compatible). Leave empty to run with tool results only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# auto: try json_schema output, fall back if the server rejects it. on | off to force.
LLM_JSON_SCHEMA=auto
LLM_TIMEOUT_S=120
LLM_CONCURRENCY=2
# true: response-cache hits only, with no live model requests.
LLM_CACHE_ONLY=false
# Daily-quota fallback cooldown; a provider Retry-After takes precedence.
LLM_QUOTA_COOLDOWN_S=3600
# Set prompt/output budgets and pacing to fit YOUR organization's limits.
# Groq free-tier example (8K TPM); this does not raise the 200K daily quota.
# LLM_PROMPT_BUDGET_TOKENS=4400
# LLM_MAX_TOKENS=2000
# LLM_TOKENS_PER_MINUTE=8000

# Free hosted alternative (requires your own free OpenRouter API key).
# Model availability and account limits must be checked before switching.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_JSON_SCHEMA=off
# LLM_REASONING_EFFORT=
#
# Local Ollama alternative (download/create the model separately; context must
# exceed the prompt + output budget). No API key or provider token quota.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-local-model-name
# LLM_CONCURRENCY=1
# LLM_TOKENS_PER_MINUTE=0

# Read-only GitHub token (raises the API limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=

# GitHub App (optional; the extension works without it)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Optional features
ENABLE_EMBEDDINGS=false
ENABLE_SANDBOX=false
# SANDBOX_ALLOWLIST=sandbox_allowlist.json

RUN_TIMEOUT_S=300
GIT_TIMEOUT_S=120
